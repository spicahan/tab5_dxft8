# The version-two slave driver fixes known write/read and clock-stretch issues
# in the original ESP-IDF I2C slave implementation.
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y

# The YD-ESP32-23 variant used here has 16 MB flash. The first milestone does
# not require its PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Match the RF-board v1.3 active 26 MHz source, AC-coupled into XA.
CONFIG_DXFT8_MOCK_SI5351_REFERENCE_HZ=26000000
CONFIG_DXFT8_MOCK_SI5351_EXTERNAL_REFERENCE=y
